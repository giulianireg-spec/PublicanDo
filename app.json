{
  "expo": {
    "name": "GuianDo",
    "slug": "guiando",
    "scheme": "guiando",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guiando.app"
    },
    "android": {
      "package": "com.guiando.apparg",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "backgroundColor": "#84CC16"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "guiando-backend-509198716878.us-east1.run.app",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "guiando-backend-509198716878.us-east1.run.app",
              "pathPrefix": "/g/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "googleWebClientId": "509198716878-nvuvkcpnfb74s171pegi81cee10c7h0m.apps.googleusercontent.com",
      "googleAndroidClientId": "509198716878-fnic4uc0mde4q6v7hq04ugfsr5c8pmn0.apps.googleusercontent.com",
      "eas": {
        "projectId": "eb3a5665-5bb6-44b7-88bd-c8793b8ddc1e"
      }
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8688791084507015~6469064442",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-dev-client",
      "@react-native-google-signin/google-signin",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing"
    ],
    "owner": "rgiuliani3612",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#84CC16"
    }
  }
}
